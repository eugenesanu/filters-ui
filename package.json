{
  "name": "filters-ui",
  "version": "1.3.3",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "prebuild": "npm run registry:check && npm run registry:build",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "registry:check": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-registry.mjs",
    "registry:build": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/build-registry.mjs"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "shiki": "4.6.0",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "postcss": "8.5.33",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2"
  }
}
